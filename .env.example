# Display-only exchange rate until the daily FX job exists (prices settle in KES).
NEXT_PUBLIC_KES_PER_USD=129

# MapLibre style for lite mode. Defaults to OpenFreeMap (free, no key).
# NEXT_PUBLIC_LITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# Neon Postgres, pooled connection string (Neon → Connect → Pooled connection).
# Change Neon's sslmode=require to sslmode=verify-full: same protection today, and it
# stays strict when the pg driver's next major version weakens "require".
DATABASE_URL=
# Signs Payload admin sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Next build steps (see docs/TECHNICAL-PLAN.md) ---
# PAYSTACK_SECRET_KEY=     # test key until legal clears live payments
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# CLOUDINARY_URL=
# RESEND_API_KEY=
